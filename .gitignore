# ============ .NET / C# 构建产物 ============
bin/
obj/
*.user
*.suo
*.userprefs
*.binlog

# ============ IDE / 编辑器 ============
.vs/
.idea/
.vscode/
*.swp
*.swo

# ============ Godot 4 ============
# 只忽略可再生的编译产物；.godot/imported 与 .godot/exported 必须入库——
# 模组的 .pck 里就包含这些导入产物，本机没有 Godot 无法重新生成。
# 注意：不能写 `.godot/`（整目录排除后无法再单独找回子目录）。
.godot/mono/
.godot/editor/
.godot/shader_cache/
.godot/uid_cache.bin
.godot/global_script_class_cache.cfg
.import/

# 注意：以下 Godot 文件【需要】提交，不要忽略
# - *.import         （资源导入配置）
# - *.uid            （资源 UID）
# - project.godot
# - export_presets.cfg

# ============ 本机路径 / 个人配置覆盖 ============
local.props
Directory.Build.user.props

# ============ 备份 / 临时文件 ============
*.old
*.old.*
*.bak
*.tmp
*.log
dev/

# ============ 参考副本（抓取自公开仓库，仅供阅读）============
# docs/参考-*/ 保留入库：它是工程约定的依据，需与代码一同演进。

# ============ NuGet ============
packages/
*.nupkg
.nuget/

# ============ OS 特定 ============
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# Godot 导出暂存目录(每次 publish 重建,不入库)
.godot/pck-stage/
