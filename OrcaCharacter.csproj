<Project Sdk="Godot.NET.Sdk/4.5.1" InitialTargets="CheckDependencyPaths">
    <!--
      Sdk 版本 4.5.1 为字面量：MSBuild 在解析 Sdk 属性时尚未加载任何 props，无法外置。
      取值理由（hardcode-ok）：游戏内置 MegaDot 4.5.1，官方说明「用更新版本 Godot 导出的 .pck 游戏不加载」。
      参照标准：Coll-ed/StS2-NotEnoughDifficulty 的 csproj。
    -->
    <Import Project=".\Sts2PathDiscovery.props" />

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>true</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AssemblyName>OrcaCharacter</AssemblyName>
        <RootNamespace>OrcaCharacter</RootNamespace>
        <AppOutputBase>$(MSBuildProjectDirectory)\</AppOutputBase>
        <PathMap>$(AppOutputBase)=.\</PathMap>
        <!-- 宿主已初始化 Godot 插件，模组程序集必须关掉这个源生成器 -->
        <GodotDisabledSourceGenerators>GodotPluginsInitializer</GodotDisabledSourceGenerators>
    </PropertyGroup>

    <PropertyGroup>
        <!-- 模组面向所有平台（MSIL），本机 StS2 是特定平台，架构不匹配警告无意义 -->
        <NoWarn>$(NoWarn);MSB3270</NoWarn>
        <CustomModsPath>$(ModsPath)$(ModFolderName)</CustomModsPath>
    </PropertyGroup>

    <!-- ── 依赖程序集：路径全部来自 Sts2PathDiscovery.props，不写死 ────────── -->
    <ItemGroup Condition="Exists('$(Sts2DataDir)')">
        <Reference Include="sts2">
            <HintPath>$(Sts2DataDir)/sts2.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="0Harmony">
            <HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <!-- BaseLib 是创意工坊模组（不是 NuGet 包），版本须与 OrcaCharacter.json 的 min_version 一致 -->
    <ItemGroup Condition="Exists('$(WorkshopDir)/$(BaseLibPublishedFileId)/BaseLib/BaseLib.dll')">
        <Reference Include="BaseLib">
            <HintPath>$(WorkshopDir)/$(BaseLibPublishedFileId)/BaseLib/BaseLib.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <!-- ── 编译项 ─────────────────────────────────────────────────────── -->
    <ItemGroup>
        <!-- Cards.cs 曾以"只恢复约 34%、从方法中间截断"为由被排除出编译。
             经核实它是早期重复恢复留下的残件,两个内容都有完整归属:
               OrcaBloodSword → Cards/OrcaBloodSword.cs(232 行,括号配平,完整)
               FrenzyStrike   → Cards/Cards-BloodBlade.cs(唯一被调用的那一份)
             且 FrenzyStrike 不在官方 dll 中(属本工程自有实现)。该文件已移除。 -->
        <!-- 资源目录不含 C#，显式排除避免 Godot 源生成器扫进去 -->
        <Compile Remove="OrcaCharacter/**" />
        <Compile Remove="docs/**" />
    </ItemGroup>

    <ItemGroup>
        <None Include=".gitignore" />
        <None Include="OrcaCharacter.json" />
        <None Include="project.godot" />
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="OrcaCharacter/localization/**/*.json" />
    </ItemGroup>

    <!-- ── 边界显式：依赖缺失就报错，不静默降级 ───────────────────────── -->
    <Target Name="CheckDependencyPaths">
        <Error Text=" 找不到《杀戮尖塔2》数据目录 '$(Sts2DataDir)'。请用 /p:Sts2Path=... 或 local.props 指定。"
               Condition="'$(Sts2DataDir)' == '' or !Exists('$(Sts2DataDir)')" />
        <Error Text=" 找不到 BaseLib（创意工坊 $(BaseLibPublishedFileId)）。请确认 BaseLib 已订阅。"
               Condition="!Exists('$(WorkshopDir)/$(BaseLibPublishedFileId)/BaseLib/BaseLib.dll')" />
    </Target>

    <!-- ── 构建后自动落到 mods 目录：源码与游戏内构件保持一致 ────────────── -->
    <!-- AfterTargets 用 Build：本工程不定义 PostBuildEvent，挂 PostBuildEvent 不会触发（实测） -->
    <Target Name="CopyToModsFolderOnBuild" AfterTargets="Build">
        <Message Text="[Orca] 复制 dll / json / pdb → $(CustomModsPath)" Importance="high" />
        <MakeDir Directories="$(CustomModsPath)" />
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(CustomModsPath)" />
        <Copy SourceFiles="$(MSBuildProjectDirectory)/OrcaCharacter.json" DestinationFolder="$(CustomModsPath)" />
        <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(CustomModsPath)" ContinueOnError="WarnAndContinue" />
    </Target>

    <!-- ── 发布时用 Godot 导出 pck（不自己拼包）────────────────────────────
         导出到暂存目录 → **校验产物** → 通过后才复制到 mods。

         判据的演进(两次实测教训):
           1) 起初用 ContinueOnError=WarnAndContinue,Godot 失败也不报 ⇒ 一次失败的导出
              把可用的 54 MB .pck 覆盖成 2.5 MB 残包。故改为"失败即致命"。
           2) 但 Spine 资源依赖**游戏目录的 GDExtension**,独立导出**必然**报错并返回非零码,
              而产物其实是完整的 ⇒ 用退出码判定会永远误报失败。
         ⇒ 最终判据:**不看 Godot 的退出码,看产物** —— .pck 必须存在,且体量不低于门槛。 -->
    <PropertyGroup>
        <PckStagingDir>$(MSBuildProjectDirectory)/.godot/pck-stage</PckStagingDir>
        <PckStagingPath>$(PckStagingDir)/$(MSBuildProjectName).pck</PckStagingPath>
        <!-- 具名常量(hardcode-ok:阈值,理由如下):
             官方基准 54,635,766 B;本工程完整导出实测 52,648,248 B(96.4%)。
             取 20,000,000 B(约官方 36.6%)为下限 —— 远高于曾出现的 2,518,204 B 残包(4.6%),
             又留足余量,避免正常的资源差异被误判为失败。 -->
        <MinPckBytes>20000000</MinPckBytes>
    </PropertyGroup>

    <Target Name="NeedGodotForPublish" BeforeTargets="Publish">
        <Error Text=" 发布需要 Godot 4.5.1 mono(MegaDot 更佳)。请设置 /p:GodotPath=... 或 local.props，当前 GodotPath='$(GodotPath)'。"
               Condition="'$(GodotPath)' == '' or !Exists('$(GodotPath)')" />
    </Target>

    <Target Name="GodotPublish" AfterTargets="Publish"
            Condition="'$(GodotPath)' != '' and Exists('$(GodotPath)') and '$(IsInnerGodotExport)' != 'true'">
        <MakeDir Directories="$(PckStagingDir)" />
        <Delete Files="$(PckStagingPath)" ContinueOnError="WarnAndContinue" />
        <Message Text="[Orca] 导出 .pck → $(PckStagingPath)" Importance="high" />
        <!-- 容忍 Godot 的非零退出码:Spine 依赖游戏 GDExtension,独立导出必然报错。
             真正的把关在下面这条:产物存在性 + 体量门槛(见 tools/check-pck.py)。 -->
        <Exec Command="&quot;$(GodotPath)&quot; --headless --export-pack &quot;BasicExport&quot; &quot;$(PckStagingPath)&quot;"
              EnvironmentVariables="IsInnerGodotExport=true;MSBUILDDISABLENODEREUSE=1"
              ContinueOnError="WarnAndContinue" />
        <!-- MSBuild 属性函数不允许 FileInfo::new()(实测 MSB4185),故体量校验交给工具。
             校验失败即构建失败,绝不覆盖可用产物。 -->
        <Exec Command="python &quot;$(MSBuildProjectDirectory)/tools/check-pck.py&quot; &quot;$(PckStagingPath)&quot; --min-bytes $(MinPckBytes)" />
        <Copy SourceFiles="$(PckStagingPath)" DestinationFolder="$(CustomModsPath)" />
        <Message Text="[Orca] .pck 已通过门槛校验并落到 $(CustomModsPath)" Importance="high" />
    </Target>
</Project>
