<Project Sdk="Microsoft.NET.Sdk">

  <!--
    OrcaCharacter —— 把「银龙奥卡」做成独立可选角色（阶段 1 MVP）
    配方参照工坊 Watcher v0.9.28（Boninall）：游戏自带 API（ModHelper 在 sts2.dll 里）为主。
    ★ 2026-09-23：**引入 BaseLib 依赖**（用户拍板）—— 只为「设置里的日志开关」：
      BaseLib 的 SimpleModConfig/ModConfigRegistry 能让配置项自动长在游戏的「模组配置」界面里，
      游戏自带 API 没有等价物。mod 的 dependencies 已同步声明 BaseLib。
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>true</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>OrcaCharacter</AssemblyName>
    <RootNamespace>OrcaCharacter</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS8632</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Sts2ModsDir>D:\\Steam\\steamapps\\common\\Slay the Spire 2\\mods</Sts2ModsDir>
    <OrcaModDir>$(Sts2ModsDir)\\奥卡角色-Orca</OrcaModDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>..\\_refs\\game\\sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>..\\_refs\\game\\GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>..\\_refs\\game\\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- ★ 2026-09-23：BaseLib（只用于设置界面里的模组配置项） -->
    <Reference Include="BaseLib">
      <HintPath>..\\_refs\\game\\BaseLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="StageToDist" AfterTargets="Build">
    <MakeDir Directories="$(MSBuildProjectDirectory)\\dist" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)\\dist" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(MSBuildProjectDirectory)\\dist" ContinueOnError="WarnAndContinue" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\\OrcaCharacter.json" DestinationFolder="$(MSBuildProjectDirectory)\\dist" />
    <Message Text="[Orca] 暂存 → $(MSBuildProjectDirectory)\\dist" Importance="high" />
  </Target>

  <Target Name="InstallToModsFolder" AfterTargets="StageToDist" Condition="'$(InstallToGameMods)' == 'true'">
    <MakeDir Directories="$(OrcaModDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\\dist\\OrcaCharacter.dll" DestinationFolder="$(OrcaModDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\\dist\\OrcaCharacter.json" DestinationFolder="$(OrcaModDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\\dist\\OrcaCharacter.pdb" DestinationFolder="$(OrcaModDir)" ContinueOnError="WarnAndContinue" />
    <Message Text="[Orca] 已安装 → $(OrcaModDir)" Importance="high" />
  </Target>


